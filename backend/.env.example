# Copy to backend/.env and fill in.

# Required
DATABASE_URL=postgresql://parsel:<parsel-password>@localhost:5432/parsel
JWT_SECRET=<long-random-string>

# Chat assistant (read-only parsel_agent login, see migrations/008_chat_agent_role.sql)
CHAT_DATABASE_URL=postgresql://parsel_agent:<agent-password>@localhost:5432/parsel
GROQ_API_KEY=<groq-api-key>

# Optional
# GROQ_MODEL=openai/gpt-oss-120b
# JWT_EXPIRE_MINUTES=10
# ENV=production
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LOG_LEVEL=INFO
