# Copy to backend/.env and fill in (setup does this for you).

# Required
JWT_SECRET=<long-random-string>

# Chat assistant and Overview insight
GROQ_API_KEY=<groq-api-key>

# Optional
# DATABASE_PATH=/absolute/path/to/parsel.db   (default: <repo>/data/parsel.db)
# GROQ_MODEL=openai/gpt-oss-120b
# JWT_EXPIRE_MINUTES=10
# ENV=production
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LOG_LEVEL=INFO
